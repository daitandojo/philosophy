# ─── Required: Authentication ───────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXTAUTH_SECRET=your_jwt_secret_generate_with_openssl_rand_base64_32
NEXTAUTH_URL=https://hikmatia.com

# ─── Required: Database ─────────────────────────────────────────
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/hikmatia

# ─── Required: AI & Content ─────────────────────────────────────
DEEPSEEK_API_KEY=sk-your_deepseek_api_key
OPENAI_API_KEY=sk-your_openai_api_key

# ─── Optional: Vector Search (Pinecone) ────────────────────────
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENV=us-east-1
PINECONE_INDEX_NAME=hikmatia

# ─── Optional: File Storage (Backblaze B2) ──────────────────────
B2_ACCESS_KEY_ID=your_b2_key_id
B2_SECRET_ACCESS_KEY=your_b2_secret_key
B2_BUCKET_NAME=hikmatia
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003

# ─── Optional: Payments (Stripe) ────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_DERVISH_PRICE_ID=price_dervish_tier
STRIPE_PATRON_PRICE_ID=price_patron_tier

# ─── Optional: Google Services ──────────────────────────────────
GOOGLE_VISION_API_KEY=your_google_vision_api_key

# ─── Optional: Cron / Admin ─────────────────────────────────────
CRON_SECRET=your_cron_secret
ADMIN_SECRET=your_admin_secret

# ─── Optional: Deployment ───────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://hikmatia.com
